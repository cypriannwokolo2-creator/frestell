# Copy to .env and fill in real values. Never commit .env.

# --- Runtime ---
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
BASE_URL=http://localhost:3001
WEBAPP_URL=http://localhost:3000
CHALLENGE_STORE=memory

# --- CORS (comma-separated, or "*") ---
CORS_ORIGINS=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=frestell
POSTGRES_PASSWORD=frestell
POSTGRES_DB=frestell
POSTGRES_PORT=5432
DATABASE_URL=postgresql://frestell:frestell@localhost:5432/frestell

# --- Cache ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth: JWT ---
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-long-random-string-at-least-16-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_NAME=refresh_token

# --- Auth: WebAuthn ---
WEB_AUTHN_RP_NAME=FreStell
WEB_AUTHN_RP_ID=localhost
WEB_AUTHN_ORIGIN=http://localhost:3000

# --- Auth: Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- Auth: Email (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@frestell.com
BREVO_SENDER_NAME=FreStell

# --- Auth: Password Reset ---
PASSWORD_RESET_EXPIRES_IN=15m
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW=3600

# --- Auth: Login Lockout ---
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION=900

# --- Auth: Account Deletion ---
ACCOUNT_DELETE_GRACE_DAYS=30

# --- Auth: Recovery Codes ---
RECOVERY_CODES_COUNT=10

# --- Auth: CSRF ---
CSRF_COOKIE_NAME=csrf-token
CSRF_SECRET=

# --- Stellar / Soroban ---
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_ESCROW_CONTRACT_ID=

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- Throttling ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_WHITE_LIST=127.0.0.1,::1

# --- Shutdown ---
SHUTDOWN_TIMEOUT_MS=10000

# --- Adminer ---
ADMINER_PORT=8080
